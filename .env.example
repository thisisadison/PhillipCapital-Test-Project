# --- Required to run the research pipeline -----------------------------------
# Server-side only. Never referenced from a client component.
ANTHROPIC_API_KEY=sk-ant-...

# Bearer secret the scheduler presents to POST /api/cron. Without it that route
# refuses to run rather than exposing an unauthenticated trigger.
CRON_SECRET=

# --- Access gate -------------------------------------------------------------
# One shared code for the team. Leave unset to run without a gate (local dev).
DIGEST_ACCESS_CODE=

# --- Optional ----------------------------------------------------------------
# Where digests and the run log are written. Must be a persistent volume.
DIGEST_DATA_DIR=./data

# Timezone for edition dates and timestamps.
DIGEST_TIMEZONE=Asia/Singapore

# Manual "regenerate now" limits.
DIGEST_MANUAL_COOLDOWN_MINUTES=30
DIGEST_MANUAL_RUNS_PER_DAY=6

# --- Cost levers -------------------------------------------------------------
# These are the two settings that actually move the bill. Web search is billed
# per search, and — the part that catches people out — every page it retrieves
# bills as input tokens on the turn it arrives and on every later turn of the
# same conversation. Lowering either number lowers spend more than it looks.
#
# Searches per digest category, across five categories.
DIGEST_MAX_SEARCHES_PER_CATEGORY=3
# Searches the programme designer's MAS Agent may make. It is the only agent in
# that pipeline with network access; the other three cost tokens only.
PROGRAMME_MAX_SEARCHES=4
